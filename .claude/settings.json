{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler secret*)",
      "Bash(npx wrangler d1 * --remote*)",
      "Bash(wrangler d1 * --remote*)",
      "Bash(npm run deploy*)",
      "PowerShell(git push *)",
      "PowerShell(npx wrangler deploy*)",
      "PowerShell(npx wrangler secret*)",
      "PowerShell(npx wrangler d1 * --remote*)",
      "PowerShell(npm run deploy*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-files.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-run-tests.js\"",
            "timeout": 330
          }
        ]
      }
    ]
  }
}
