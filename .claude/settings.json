{
  "permissions": {
    "ask": [
      "Bash(* --remote*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler secret*)",
      "Bash(npm run deploy*)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "PowerShell(* --remote*)",
      "PowerShell(*wrangler deploy*)",
      "PowerShell(*wrangler versions deploy*)",
      "PowerShell(*wrangler secret*)",
      "PowerShell(npm run deploy*)",
      "PowerShell(git push*)",
      "PowerShell(git -C * push*)",
      "PowerShell(git -c * push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-files.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-run-tests.js\"",
            "timeout": 330
          }
        ]
      }
    ]
  }
}
